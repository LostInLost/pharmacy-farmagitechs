---
import BaseLayout from "@/layouts/base-layout.astro"
import { AppShell } from "@/components/app-shell"
import {
  ReceptionsView,
  type ReceptionSheetState,
} from "@/features/receptions/components/receptions-view"

// Sheet awal dari query string: `?new=1`, `?view=<id>`, atau `?edit=<id>`.
// Prioritas edit → view → new, sehingga tautan lama `?edit=…` tetap menang.
const params = Astro.url.searchParams

function numericParam(name: string): number | null {
  const raw = params.get(name)

  return raw !== null && /^\d+$/.test(raw) ? Number(raw) : null
}

let initialSheet: ReceptionSheetState | null = null

const editId = numericParam("edit")
const viewId = numericParam("view")

if (editId !== null) {
  initialSheet = { mode: "edit", id: editId }
} else if (viewId !== null) {
  initialSheet = { mode: "view", id: viewId }
} else if (params.get("new") === "1") {
  initialSheet = { mode: "create" }
}

const permissions = Astro.locals.user?.permissions ?? []
---

<BaseLayout title="Penerimaan">
  <AppShell
    client:load
    user={Astro.locals.user}
    pathname={Astro.url.pathname}
    title="Penerimaan"
  >
    <ReceptionsView
      client:load
      initialSheet={initialSheet}
      permissions={permissions}
    />
  </AppShell>
</BaseLayout>
