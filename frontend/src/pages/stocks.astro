---
import BaseLayout from "@/layouts/base-layout.astro"
import { AppShell } from "@/components/app-shell"
import { StockReport } from "@/features/stocks/components/stock-report"

// Sheet detail batch dari query string: `?view=<medicine_id>`.
const raw = Astro.url.searchParams.get("view")
const initialViewId = raw !== null && /^\d+$/.test(raw) ? Number(raw) : null
---

<BaseLayout title="Laporan Stok">
  <AppShell
    client:load
    user={Astro.locals.user}
    pathname={Astro.url.pathname}
    title="Laporan Stok"
  >
    <StockReport client:load initialViewId={initialViewId} />
  </AppShell>
</BaseLayout>
