---
import "@/styles/global.css"

interface Props {
  title: string
}

const appName = import.meta.env.PUBLIC_APP_NAME ?? "Farmagitechs"
const { title } = Astro.props
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · {appName}</title>
    <script is:inline>
      // Terapkan tema sebelum paint pertama supaya tidak berkedip.
      (function () {
        try {
          var saved = localStorage.getItem("farmagitechs.theme") || "system"
          var dark =
            saved === "dark" ||
            (saved === "system" &&
              window.matchMedia("(prefers-color-scheme: dark)").matches)

          document.documentElement.classList.toggle("dark", dark)
        } catch (error) {
          // localStorage diblokir: biarkan tema terang bawaan.
        }
      })()
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
