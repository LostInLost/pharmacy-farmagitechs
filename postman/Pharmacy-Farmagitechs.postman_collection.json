                        "body": { "mode": "raw", "raw": "{\n  \"username\": \"supervisor\",\n  \"password\": \"supervisor123\"\n}" },
                        "url": { "raw": "{{base_url}}/api/login", "host": ["{{base_url}}"], "path": ["api", "login"] },
                        "description": "Menyiapkan sesi supervisor untuk membuat penerimaan milik orang lain."
                    }
                },
                {
                    "name": "3.12 Supervisor membuat penerimaan orang lain (persiapan)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('status 201', function () { pm.response.to.have.status(201); });",
                                    "const body = pm.response.json();",
                                    "pm.collectionVariables.set('foreign_receipt_id', body.data.id);",
                                    "pm.collectionVariables.set('foreign_reference', body.data.reference_no);",
                                    "pm.test('pembuat adalah supervisor', function () { pm.expect(body.data.created_by_name).to.eql('Rina Supervisor'); });"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"reference_no\": \"PB-SUP-{{$timestamp}}\",\n  \"supplier_id\": 1,\n  \"received_at\": \"2026-10-04T10:00:00+07:00\",\n  \"items\": [\n    {\"medicine_id\": 102, \"batch_no\": \"AMX-2601\", \"expires_on\": \"2027-06-30\", \"quantity\": 5}\n  ]\n}"
                        },
                        "url": { "raw": "{{base_url}}/api/receipts", "host": ["{{base_url}}"], "path": ["api", "receipts"] },
                        "description": "Membuat penerimaan atas nama supervisor; id-nya dipakai item berikutnya. Nomor referensi memakai timestamp agar aman dijalankan berulang."
                    }
                },
                {
                    "name": "3.13 Login petugas kembali",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('status 200', function () { pm.response.to.have.status(200); });",
                                    "pm.test('role reception', function () { pm.expect(pm.response.json().user.role).to.eql('reception'); });"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": { "mode": "raw", "raw": "{\n  \"username\": \"petugas\",\n  \"password\": \"petugas123\"\n}" },
                        "url": { "raw": "{{base_url}}/api/login", "host": ["{{base_url}}"], "path": ["api", "login"] },
                        "description": "Memulihkan sesi petugas sebelum uji penolakan hak akses."
                    }
                },
                {
                    "name": "3.14 Ubah penerimaan orang lain sebagai petugas (403)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('status 403', function () { pm.response.to.have.status(403); });",
                                    "pm.test('bukan 403 CSRF', function () {",
                                    "    const body = pm.response.json();",
                                    "    pm.expect(body.error).to.not.eql('csrf');",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "PUT",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"reference_no\": \"PB-SUP-1\",\n  \"supplier_id\": 1,\n  \"received_at\": \"2026-10-04T10:00:00+07:00\",\n  \"items\": [\n    {\"medicine_id\": 102, \"batch_no\": \"AMX-2601\", \"expires_on\": \"2027-06-30\", \"quantity\": 99}\n  ]\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/receipts/{{foreign_receipt_id}}",
                            "host": ["{{base_url}}"],
                            "path": ["api", "receipts", "{{foreign_receipt_id}}"]
                        },
                        "description": "Petugas mengubah penerimaan milik supervisor; harus ditolak 403 oleh policy, bukan oleh CSRF."
                    }
                }
            ]
        },
        {
            "name": "4. Unauthenticated (jalankan paling akhir)",
            "item": [
                {
                    "name": "4.1 Buat penerimaan tanpa login (401)",
                    "event": [
                        {
                            "listen": "prerequest",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "// Header Cookie manual menimpa cookie jar, jadi cookie CSRF yang sah",
                                    "// harus disertakan eksplisit agar request gagal di autentikasi, bukan CSRF.",
                                    "const token = pm.cookies.get('csrf_cookie_name') || pm.collectionVariables.get('csrf_token');",
                                    "pm.request.headers.upsert({ key: 'Cookie', value: 'ci_session=token-tidak-valid; csrf_cookie_name=' + token });",
                                    "pm.request.headers.upsert({ key: 'X-CSRF-TOKEN', value: token });"
                                ]
                            }
                        },
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('status 401', function () { pm.response.to.have.status(401); });",
                                    "pm.test('bukan kegagalan CSRF', function () {",
                                    "    pm.expect(pm.response.json().error).to.not.eql('csrf');",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"reference_no\": \"PB-NOAUTH\",\n  \"supplier_id\": 1,\n  \"received_at\": \"2026-10-03T10:00:00+07:00\",\n  \"items\": [\n    {\"medicine_id\": 101, \"batch_no\": \"PCT-2601\", \"expires_on\": \"2027-12-31\", \"quantity\": 1}\n  ]\n}"
                        },
                        "url": { "raw": "{{base_url}}/api/receipts", "host": ["{{base_url}}"], "path": ["api", "receipts"] },
                        "description": "Token CSRF sah tetapi sesi tidak valid: filter autentikasi menolak dengan 401."
                    }
                },
                {
                    "name": "4.2 Laporan stok tanpa login (401)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": ["pm.test('status 401', function () { pm.response.to.have.status(401); });"]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [{ "key": "Cookie", "value": "ci_session=token-tidak-valid" }],
                        "url": { "raw": "{{base_url}}/api/stocks", "host": ["{{base_url}}"], "path": ["api", "stocks"] },
                        "description": "GET tidak dilindungi CSRF, sehingga penolakan datang murni dari autentikasi."
                    }
                },
                {
                    "name": "4.3 POST tanpa token CSRF (403)",
                    "event": [
                        {
                            "listen": "prerequest",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "// Hapus token yang biasanya disisipkan script koleksi agar request",
                                    "// benar-benar dikirim tanpa X-CSRF-TOKEN.",
                                    "pm.request.headers.remove('X-CSRF-TOKEN');"
                                ]
                            }
                        },
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('status 403', function () { pm.response.to.have.status(403); });",
                                    "pm.test('penanda error csrf', function () { pm.expect(pm.response.json().error).to.eql('csrf'); });",
                                    "pm.test('menyertakan token segar untuk percobaan ulang', function () {",
                                    "    pm.expect(pm.response.headers.get('X-CSRF-TOKEN')).to.be.a('string').and.not.empty;",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"reference_no\": \"PB-NOCSRF\",\n  \"supplier_id\": 1,\n  \"received_at\": \"2026-10-03T10:00:00+07:00\",\n  \"items\": [\n    {\"medicine_id\": 101, \"batch_no\": \"PCT-2601\", \"expires_on\": \"2027-12-31\", \"quantity\": 1}\n  ]\n}"
                        },
                        "url": { "raw": "{{base_url}}/api/receipts", "host": ["{{base_url}}"], "path": ["api", "receipts"] },
                        "description": "Tanpa token CSRF, endpoint mutasi dijawab JSON 403 sebelum filter autentikasi berjalan."
                    }
                },
                {
                    "name": "4.4 POST dengan token CSRF tidak cocok (403)",
                    "event": [
                        {
                            "listen": "prerequest",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "// Token acak yang tidak sama dengan nilai cookie csrf_cookie_name.",
                                    "pm.request.headers.upsert({ key: 'X-CSRF-TOKEN', value: 'token-palsu-tidak-cocok' });"
                                ]
                            }
                        },
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('status 403', function () { pm.response.to.have.status(403); });",
                                    "pm.test('penanda error csrf', function () { pm.expect(pm.response.json().error).to.eql('csrf'); });"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"reference_no\": \"PB-BADTOKEN\",\n  \"supplier_id\": 1,\n  \"received_at\": \"2026-10-03T10:00:00+07:00\",\n  \"items\": [\n    {\"medicine_id\": 101, \"batch_no\": \"PCT-2601\", \"expires_on\": \"2027-12-31\", \"quantity\": 1}\n  ]\n}"
                        },
                        "url": { "raw": "{{base_url}}/api/receipts", "host": ["{{base_url}}"], "path": ["api", "receipts"] },
                        "description": "Token harus sama dengan nilai cookie csrf_cookie_name; token palsu ditolak 403."
                    }
                }
            ]
        }
    ]
}
