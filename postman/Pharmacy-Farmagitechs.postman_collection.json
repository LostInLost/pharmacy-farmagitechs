                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('status 200', function () { pm.response.to.have.status(200); });",
                                    "const body = pm.response.json();",
                                    "const find = (id) => body.medicines.find((m) => m.medicine_id === id);",
                                    "pm.test('on_date dipakai', function () { pm.expect(body.on_date).to.eql('2026-10-03'); });",
                                    "pm.test('obat 101 fisik 142', function () { pm.expect(find(101).physical_quantity).to.eql(142); });",
                                    "pm.test('obat 101 tersedia 134', function () { pm.expect(find(101).available_quantity).to.eql(134); });",
                                    "pm.test('obat 101 kedaluwarsa 8', function () { pm.expect(find(101).expired_quantity).to.eql(8); });",
                                    "pm.test('obat 102 tersedia 16', function () { pm.expect(find(102).available_quantity).to.eql(16); });",
                                    "pm.test('obat 103 tersedia 15', function () { pm.expect(find(103).available_quantity).to.eql(15); });",
                                    "pm.test('obat 104 tersedia 3', function () { pm.expect(find(104).available_quantity).to.eql(3); });",
                                    "pm.test('obat 106 fisik 0', function () { pm.expect(find(106).physical_quantity).to.eql(0); });",
                                    "pm.test('obat 107 fisik 6 tersedia 0', function () {",
                                    "    pm.expect(find(107).physical_quantity).to.eql(6);",
                                    "    pm.expect(find(107).available_quantity).to.eql(0);",
                                    "});"
                                ]
                            }
